# Backend Environment Variables
# Copy this file to .env and update the values

# Server Port
PORT=3002

# Node Environment (production/development)
NODE_ENV=production

# GitHub Token (required for creating PRs)
# Generate at: https://github.com/settings/tokens
# Required scopes: repo
GITHUB_TOKEN=

# AI Provider API Keys (optional - for complex AI-powered fixes)
# OpenAI Key: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Google Gemini Key (100% Free): https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Python binary command (optional: python on Windows, python3 on Linux)
PYTHON_BIN=
